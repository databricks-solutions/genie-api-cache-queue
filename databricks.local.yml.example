# Per-developer overlay for `databricks.yml`.
#
# Copy this file to `databricks.local.yml` (gitignored) and uncomment / edit
# the lines below. The bundle's `include: ["*.local.yml"]` glob will pick it
# up automatically — both CLI deploys and IDE deploys (VS Code Databricks
# extension, etc.) honor it without any per-invocation flag.
#
# When to use this:
#   * Your ${workspace.current_user.short_name} contains underscores or dots
#     (e.g. "alex_witt", "alex.witt") — Lakebase branch IDs reject those
#     characters. Set `dev_user` to a sanitized lowercase-and-hyphens form
#     (e.g. "alex-witt") so the dev target's branch_id ("dev-${var.dev_user}")
#     matches what's already deployed.
#
# Without this override, `bundle deploy` may offer to RECREATE the dev branch
# because the computed branch_id (with underscores) does not match the live
# branch_id (with hyphens). Recreation deletes all data in the branch — say
# no, set this overlay, redeploy.

# variables:
#   dev_user:
#     default: alex-witt
